<%- include("../partials/header.ejs") %>

<body>
    <nav>
        <h2><a href="/">RECIPE GO</a></h2>

        <div>
            <a href="/">HOME</a>
            <a href="/saved">SAVED</a>
            <a href="/signin">LOGIN</a>
        </div>
    </nav>

    <main>
        <header>
            <h1>Find a MEAL</h1>

            <form id="searchForm">
                <input type="text" id="search" placeholder="Search Recipes...">
                <button type="submit">SEARCH</button>
            </form>
        </header>

        <section>
            <div class="sectionHeading">
                <h2>RECIPES</h2>

                <button type="button" id="filterButton">
                    FILTER
                </button>
            </div>

            <div id="filters" hidden>
                <div>
                    <label for="timeFilter">COOKING TIME</label>

                    <select id="timeFilter">
                        <option value="0">Any Time</option>
                        <option value="15">15 Minutes or Less</option>
                        <option value="30">30 Minutes or Less</option>
                        <option value="60">60 Minutes or Less</option>
                    </select>
                </div>

                <div>
                    <label for="difficultyFilter">DIFFICULTY</label>

                    <select id="difficultyFilter">
                        <option value="all">Any Difficulty</option>
                        <option value="Easy">Easy</option>
                        <option value="Medium">Medium</option>
                        <option value="Hard">Hard</option>
                    </select>
                </div>

                <div>
                    <label for="ratingFilter">MINIMUM RATING</label>

                    <select id="ratingFilter">
                        <option value="0">Any Rating</option>
                        <option value="1">1+ Stars</option>
                        <option value="2">2+ Stars</option>
                        <option value="3">3+ Stars</option>
                        <option value="4">4+ Stars</option>
                        <option value="5">5 Stars</option>
                    </select>
                </div>

                <button type="button" id="clearFilters">
                    CLEAR FILTERS
                </button>

            </div>

            <div class="recipes">
                    <!--PLEASE REMOVE ME LATER-->
                    
                    <% const recipes = [
                    { name: "Spaghetti", time: 30, difficulty: "Easy", rating: 5 },
                    { name: "Pancakes", time: 20, difficulty: "Easy", rating: 4 },
                    { name: "Salad", time: 15, difficulty: "Easy", rating: 4 },
                    { name: "Burger", time: 35, difficulty: "Medium", rating: 5 }
                    ]; %>

                    <% recipes.forEach(recipe => { %>

                        <article class="recipe" data-name="<%= recipe.name.toLowerCase() %>" data-time="<%= recipe.time %>" data-difficulty="<%= recipe.difficulty %>" data-rating="<%= recipe.rating %>">

                            <div class="recipeImage">
                                <p><%= recipe.name %></p>
                            </div>

                            <h3><%= recipe.name %></h3>

                            <p>
                                <%= recipe.time %> minutes |
                                <%= recipe.difficulty %>
                            </p>

                            <p class="rating">
                                ★ <%= recipe.rating %>/5
                            </p>

                            <a href="/view_recipe">View Recipe</a>

                            <button type="button" class="saveRecipe" data-id="<%= recipes.indexOf(recipe) + 1 %>">
                                ☆ SAVE
                            </button>

                        </article>

                    <% }); %>

            </div>

            <p id="noResults" hidden>No recipes found.</p>

        </section>

        <section class="submitSection">
            <h2>Have a Recipe?</h2>
            <p>Share your own homemade Recipe!</p>

            <a href="/preview_submission">SUBMIT RECIPE</a>
        </section>

    </main>

    <script>
        const searchForm = document.getElementById("searchForm");
        const search = document.getElementById("search");
        const recipes = document.querySelectorAll(".recipe");
        const noResults = document.getElementById("noResults");
        const filterButton = document.getElementById("filterButton");
        const filters = document.getElementById("filters");
        const timeFilter = document.getElementById("timeFilter");
        const difficultyFilter = document.getElementById("difficultyFilter");
        const ratingFilter = document.getElementById("ratingFilter");
        const clearFilters = document.getElementById("clearFilters");

        searchForm.addEventListener("submit", function(event)
        {
            event.preventDefault();
            filterRecipes();
        });

        filterButton.addEventListener("click", function()
        {
            filters.hidden = !filters.hidden;
        });

        search.addEventListener("input", filterRecipes);
        timeFilter.addEventListener("change", filterRecipes);
        difficultyFilter.addEventListener("change", filterRecipes);
        ratingFilter.addEventListener("change", filterRecipes);

        clearFilters.addEventListener("click", function()
        {
            search.value = "";
            timeFilter.value = "0";
            difficultyFilter.value = "all";
            ratingFilter.value = "0";

            filterRecipes();
        });

        function filterRecipes()
        {
            const searchText = search.value.toLowerCase().trim();
            const maxTime = Number(timeFilter.value);
            const difficulty = difficultyFilter.value;
            const minRating = Number(ratingFilter.value);

            let found = false;

            recipes.forEach(function(recipe)
            {
                const name = recipe.dataset.name;
                const time = Number(recipe.dataset.time);
                const recipeDifficulty = recipe.dataset.difficulty;
                const rating = Number(recipe.dataset.rating);
                const matchesSearch = name.includes(searchText);
                const matchesTime = maxTime === 0 || time <= maxTime;
                const matchesDifficulty = difficulty === "all" || recipeDifficulty === difficulty;
                const matchesRating = rating >= minRating;

                if (matchesSearch && matchesTime &&
                    matchesDifficulty && matchesRating)
                {
                    recipe.hidden = false;
                    found = true;
                }
                else
                {
                    recipe.hidden = true;
                }
            });

            noResults.hidden = found;
        }

        const saveButtons = document.querySelectorAll(".saveRecipe");

        let favorites = JSON.parse(localStorage.getItem("favorites") || "[]");

        saveButtons.forEach(function(button)
        {
            const id = Number(button.dataset.id);

            function updateButton()
            {
                button.textContent = favorites.includes(id) ? "★ SAVED" : "☆ SAVE";
            }

            button.addEventListener("click", function()
            {
                if (favorites.includes(id))
                {
                    favorites = favorites.filter(function(savedId)
                    {
                        return savedId !== id;
                    });
                }
                else
                {
                    favorites.push(id);
                }

                localStorage.setItem("favorites", JSON.stringify(favorites));
                updateButton();
            });

            updateButton();
        });

    </script>
</body>
</html>