<%- include("../partials/header.ejs") %>

<body>
    <nav>
        <h2><a href="/">RECIPE GO</a></h2>

        <div>
            <a href="/">HOME</a>
            <a href="/saved">SAVED</a>
            <a href="/signin">LOGIN</a>
        </div>
    </nav>

    <main>
        <header>
            <h1>Find a MEAL</h1>

            <form id="searchForm">
                <input type="text" id="search" placeholder="Search Recipes...">
                <button type="submit">SEARCH</button>
            </form>
        </header>

        <section>
            <div class="sectionHeading">
                <h2>RECIPES</h2>

                <button type="button" id="filterButton">
                    FILTER
                </button>
            </div>

            <div class="recipes">
                    <!--PLEASE REMOVE ME LATER-->
                    
                    <% const recipes = [
                    { name: "Spaghetti", time: 30, difficulty: "Easy", rating: 5 },
                    { name: "Pancakes", time: 20, difficulty: "Easy", rating: 4 },
                    { name: "Salad", time: 15, difficulty: "Easy", rating: 4 },
                    { name: "Burger", time: 35, difficulty: "Medium", rating: 5 }
                    ]; %>

                    <% recipes.forEach(recipe => { %>

                        <article class="recipe" data-name="<%= recipe.name.toLowerCase() %>">

                            <div class="recipeImage">
                                <p><%= recipe.name %></p>
                            </div>

                            <h3><%= recipe.name %></h3>

                            <p>
                                <%= recipe.time %> minutes |
                                <%= recipe.difficulty %>
                            </p>

                            <p class="rating">
                                ★ <%= recipe.rating %>/5
                            </p>

                            <a href="/view_recipe">View Recipe</a>

                        </article>

                    <% }); %>

            </div>

            <p id="noResults" hidden>No recipes found.</p>

        </section>

        <section class="submitSection">
            <h2>Have a Recipe?</h2>
            <p>Share your own homemade Recipe!</p>

            <a href="/recipe_submit">SUBMIT RECIPE</a>
        </section>

    </main>

    <script>

        const searchForm = document.getElementById("searchForm");
        const search = document.getElementById("search");
        const recipes = document.querySelectorAll(".recipe");
        const noResults = document.getElementById("noResults");

        searchForm.addEventListener("submit", function(event)
        {
            event.preventDefault();
        });

        search.addEventListener("input", function()
        {
            let found = false;

            recipes.forEach(function(recipe)
            {
                const name = recipe.dataset.name;

                if (name.includes(search.value.toLowerCase().trim()))
                {
                    recipe.hidden = false;
                    found = true;
                }
                else
                {
                    recipe.hidden = true;
                }
            });

            noResults.hidden = found;
        });

        const filterButton = document.getElementById("filterButton");
        const filters = document.getElementById("filters");

        filterButton.addEventListener("click", function()
        {
            filters.hidden = !filters.hidden;
        });

    </script>
</body>
</html>